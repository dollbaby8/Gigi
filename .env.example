# Accountability Content Engine — secrets template.
#
# Copy this file to ".env" and fill in values as needed.
#   cp .env.example .env
#
# .env is git-ignored. NEVER commit real keys.
#
# Phase 1 (Case-to-Script) needs NO secrets at all. The keys below are only
# relevant in Phase 3 (Schedule & Track), which is not built yet.

# --- Phase 3 only: posting API (Publer is the first target) ---------------
# PUBLER_API_KEY=
# PUBLER_WORKSPACE_ID=

# Alternate schedulers (pluggable; pick one in Phase 3):
# BUFFER_ACCESS_TOKEN=
# LATER_API_KEY=
# METRICOOL_API_KEY=
