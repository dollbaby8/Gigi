# Secrets — never commit
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# OS
.DS_Store
Thumbs.db

# Real-campaign content stays OUT of version control. Generated drafts can name
# real parties in active litigation; do not store them in git history. They live
# on the operator's machine only and are re-generated from the ledger as needed.
drafts/pending_review/*
!drafts/pending_review/.gitkeep
drafts/approved/*
!drafts/approved/.gitkeep

# case_files/ is left TRACKED because it currently holds only the clearly-labeled
# FICTIONAL sample documents used for the Phase 1 demo. When you drop in REAL
# case files, uncomment the lines below so they are never committed:
# case_files/*
# !case_files/.gitkeep
